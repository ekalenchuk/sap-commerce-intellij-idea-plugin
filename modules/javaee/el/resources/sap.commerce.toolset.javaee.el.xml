    <dependencies>
        <plugin id="com.intellij.spring"/>
        <plugin id="com.intellij.javaee"/>
        <plugin id="com.intellij.javaee.el"/>
        <module name="intellij.spring.el"/>
        <module name="sap.commerce.toolset.cockpitNG.core"/>
