<idea-plugin>

    <dependencies>
        <module name="intellij.platform.ui.jcef"/>
        <module name="sap.commerce.toolset.shared.core"/>
        <module name="sap.commerce.toolset.exec.core"/>
    </dependencies>

    <extensionPoints>
        <extensionPoint qualifiedName="sap.commerce.toolset.ui.toolWindowProvider"
                        interface="sap.commerce.toolset.ui.toolwindow.CxToolWindowContentProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="sap.commerce.toolset.ui.splitEditorFactory"
                        interface="sap.commerce.toolset.ui.editor.SplitEditorFactory"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <psi.treeChangeListener implementation="sap.commerce.toolset.ui.editor.event.ParameterizedSplitEditorPsiTreeChangeListener"/>
        <fileEditorProvider implementation="sap.commerce.toolset.editor.HybrisSplitFileEditorProvider"/>

        <applicationConfigurable id="hybris.settings" parentId="root" displayName="[y] SAP CX"
                                 provider="sap.commerce.toolset.options.ApplicationSettingsConfigurableProvider"/>

        <toolWindow id="SAP CX" icon="/icons/toolWindow.svg" anchor="bottom" canCloseContents="true"
                    factoryClass="sap.commerce.toolset.toolwindow.HybrisToolWindowFactory"/>

        <postStartupActivity order="after hybrisProjectImport" implementation="sap.commerce.toolset.startup.WhatsNewStartupActivity"/>
        <backgroundPostStartupActivity implementation="sap.commerce.toolset.startup.HybrisPluginUpdateCheckerStartupActivity"/>
    </extensions>

    <actions>
        <action id="sap.commerce.toolset.splitEditor.hideInEditorResults"
                class="sap.commerce.toolset.actionSystem.HideInEditorResultsAction"/>

        <group id="HybrisToolsActions"
               text="[y] SAP Commerce"
               popup="true"
               class="sap.commerce.toolset.actionSystem.CxToolsetActionGroup">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>

</idea-plugin>
