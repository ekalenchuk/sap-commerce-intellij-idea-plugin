<idea-plugin>

    <dependencies>
        <plugin id="org.jetbrains.kotlin"/>
        <module name="sap.commerce.toolset.shared.core"/>
        <module name="sap.commerce.toolset.java.core"/>
        <module name="sap.commerce.toolset.project.core"/>
        <module name="sap.commerce.toolset.project.extensioninfo"/>
        <module name="sap.commerce.toolset.project.import.core"/>
        <module name="sap.commerce.toolset.flexibleSearch.core"/>
        <module name="sap.commerce.toolset.polyglotQuery.core"/>
    </dependencies>

    <extensions defaultExtensionNs="sap.commerce.toolset">
        <project.importConfigurator implementation="sap.commerce.toolset.kotlin.configurator.KotlinConfigurator"/>
        <project.postImportConfigurator implementation="sap.commerce.toolset.kotlin.configurator.KotlinPostImportConfigurator"/>
        <project.whenSmartConfigurator implementation="sap.commerce.toolset.kotlin.configurator.KotlinWhenSmartConfigurator"/>

        <project.postImportLegacyConfigurator implementation="sap.commerce.toolset.kotlin.configurator.KotlinFacetConfigurator"/>

        <project.storage.cleanupConfigurator order="after cleanupLibrariesStorageConfigurator"
                                             implementation="sap.commerce.toolset.kotlin.configurator.entities.CleanupKotlinProjectLibraryStorageConfigurator"/>

        <project.module.contentRootEntryConfigurator implementation="sap.commerce.toolset.kotlin.configurator.contentEntry.KotlinSourcesContentRootEntryConfigurator"/>
        <project.module.contentRootEntryConfigurator implementation="sap.commerce.toolset.kotlin.configurator.contentEntry.KotlinTestSourcesContentRootEntryConfigurator"/>

        <project.module.libraryConfigurator order="after compileModuleLibraryConfigurator"
                                            implementation="sap.commerce.toolset.kotlin.configurator.library.KotlinCompileModuleLibraryConfigurator"/>
        <project.module.libraryConfigurator order="after testModuleLibraryConfigurator"
                                            implementation="sap.commerce.toolset.kotlin.configurator.library.KotlinTestModuleLibraryConfigurator"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <defaultLiveTemplates file="liveTemplates/Kotlin.xml"/>
        <languageInjector implementation="sap.commerce.toolset.codeInsight.injection.FlexibleSearchToKotlinLanguageInjector"/>
        <languageInjector implementation="sap.commerce.toolset.codeInsight.injection.PolyglotQueryToKotlinLanguageInjector"/>
    </extensions>
</idea-plugin>
